<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>Supplier Integration</title>
        <title lang="de-DE">Lieferantenintegration</title>
        <input-field type="bool">
            <name>useDemoData</name>
            <label>Use demo supplier data</label>
            <label lang="de-DE">Demo-Lieferantendaten verwenden</label>
            <defaultValue>true</defaultValue>
        </input-field>
        <input-field type="int">
            <name>syncBatchSize</name>
            <label>Synchronization batch size</label>
            <label lang="de-DE">Synchronisierungs-Batchgröße</label>
            <defaultValue>100</defaultValue>
            <min>1</min>
            <max>1000</max>
        </input-field>
    </card>
</config>
