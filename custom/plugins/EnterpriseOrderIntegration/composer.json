{
  "name": "bro/enterprise-order-integration",
  "description": "Reliable asynchronous Shopware order export to an ERP system with diagnostics and monitoring.",
  "type": "shopware-platform-plugin",
  "license": "proprietary",
  "version": "1.0.1",
  "require": {
    "php": ">=8.3",
    "shopware/core": "~6.7.0"
  },
  "autoload": {
    "psr-4": {
      "EnterpriseOrderIntegration\\": "src/"
    }
  },
  "extra": {
    "shopware-plugin-class": "EnterpriseOrderIntegration\\EnterpriseOrderIntegration",
    "label": {
      "en-GB": "Enterprise Order Integration",
      "de-DE": "ERP-Auftragsintegration"
    },
    "description": {
      "en-GB": "Exports paid Shopware orders to an ERP asynchronously with retry handling and monitoring.",
      "de-DE": "Exportiert bezahlte Shopware-Bestellungen asynchron an ein ERP-System mit Wiederholungen und Monitoring."
    },
    "manufacturerLink": {
      "en-GB": "https://github.com/rami-aouinti/shopware-bro",
      "de-DE": "https://github.com/rami-aouinti/shopware-bro"
    },
    "supportLink": {
      "en-GB": "https://github.com/rami-aouinti/shopware-bro/issues",
      "de-DE": "https://github.com/rami-aouinti/shopware-bro/issues"
    }
  },
  "authors": [
    {
      "name": "Rami Aouinti",
      "role": "Developer"
    }
  ]
}
