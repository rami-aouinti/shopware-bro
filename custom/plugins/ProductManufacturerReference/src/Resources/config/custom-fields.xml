<?xml version="1.0" encoding="UTF-8"?>
<custom-fields xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/CustomField/Schema/custom-fields-1.0.xsd">

    <custom-field-set>
        <name>rami_manufacturer_reference_set</name>

        <label>Product Manufacturer Reference</label>
        <label lang="de-DE">Herstellerreferenz für Produkte</label>

        <related-entities>
            <product/>
        </related-entities>

        <fields>
            <text name="rami_manufacturer_reference">
                <label>Manufacturer reference</label>
                <label lang="de-DE">Herstellerreferenz</label>

                <help-text>Internal reference assigned by the manufacturer</help-text>
                <help-text lang="de-DE">Interne Referenz des Herstellers</help-text>

                <position>1</position>
                <required>false</required>
            </text>
        </fields>
    </custom-field-set>
</custom-fields>
