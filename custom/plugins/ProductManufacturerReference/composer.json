  "type": "shopware-platform-plugin",
  "version": "1.0.1",
  "license": "MIT",
  "authors": [
    {
      "name": "Rami Aouinti",
      "email": "rami.aouinti@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "shopware/core": "~6.7.13"
