<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <prototype namespace="Rami\B2BCartRules\" resource="../../" exclude="../../{Resources,Tests,B2BCartRules.php}"/>

        <service id="Rami\B2BCartRules\Service\ProductOrderRuleCartValidator">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="Rami\B2BCartRules\Service\ProductOrderRuleValidator"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="translator"/>
        </service>
    </services>
</container>
