{
    "name": "shopware/production",
    "license": "MIT",
    "type": "project",
    "require": {
        "composer-runtime-api": "^2.0",
        "bro/tech-parts-erp-connector": "0.1.0",
        "shopware/administration": "*",
        "shopware/core": "6.7.15.1",
        "shopware/deployment-helper": "*",
        "shopware/elasticsearch": "*",
        "shopware/storefront": "*",
        "swag/paypal": "10.8.5",
        "symfony/amqp-messenger": "*",
        "symfony/flex": "~2",
        "symfony/runtime": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "custom/plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/plugins/*/packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "composer",
            "url": "https://shopware.github.io/conflicts/"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs:check": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "stan": "phpstan analyse --configuration=phpstan.neon.dist",
        "psalm": "psalm --config=psalm.xml",
        "mess-detector": "phpmd custom/plugins/TechPartsErpConnector/src text phpmd.xml",
        "test:plugin": "phpunit --configuration=phpunit.dist.xml custom/plugins/TechPartsErpConnector/tests/Unit",
        "quality": [
            "@cs:check",
            "@stan",
            "@psalm",
            "@mess-detector",
            "@test:plugin"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "docker": false,
            "endpoint": [
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ]
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13",
        "vimeo/psalm": "^6.0"
    }
}
