<?xml version="1.0"?>
<ruleset
    name="Bro World Mess Detector"
    xmlns="http://pmd.sf.net/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 https://pmd.sourceforge.io/ruleset_xml_schema.xsd"
>
    <description>Maintainability rules for the TechParts ERP Connector plugin.</description>

    <rule ref="rulesets/cleancode.xml">
        <!-- Shopware intentionally uses static UUID and Context factory helpers. -->
        <exclude name="StaticAccess"/>
        <!-- Fully qualified exception names are acceptable; import usage is a style choice. -->
        <exclude name="MissingImport"/>
    </rule>
    <rule ref="rulesets/codesize.xml"/>
</ruleset>
